{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "urgent",
        "event",
        "policy",
        "internal"
      ],
      "title": "Category",
      "default": "general"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Priority",
      "default": "medium"
    },
    "is_pinned": {
      "type": "boolean",
      "title": "Pinned",
      "default": false
    },
    "published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "branch",
        "position",
        "specific"
      ],
      "title": "Target Audience",
      "default": "all"
    },
    "target_branches": {
      "type": "array",
      "title": "Target Branches",
      "items": {
        "type": "string"
      }
    },
    "target_positions": {
      "type": "array",
      "title": "Target Positions",
      "items": {
        "type": "string"
      }
    },
    "target_emails": {
      "type": "array",
      "title": "Target Specific Members (emails)",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "content"
  ]
}