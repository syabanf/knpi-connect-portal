{
  "name": "ContentBlock",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Key"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "type": {
      "type": "string",
      "enum": [
        "hero",
        "about",
        "program",
        "cta",
        "footer"
      ],
      "title": "Type"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "order": {
      "type": "number",
      "title": "Order",
      "default": 0
    }
  },
  "required": [
    "key",
    "title"
  ]
}